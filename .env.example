PORT=3000
ENVIROMENT=local

# MongoDB for owner records and default app data.
DB_URL=mongodb+srv://USER:PASSWORD@HOST/ready-deliveries

# Public platform domain used to generate tenant subdomains.
OWNER_BASE_DOMAIN=readydeliveries.com

# Optional: use if tenant DB URLs differ from DB_URL.
# TENANT_DB_URL_TEMPLATE=mongodb+srv://USER:PASSWORD@HOST/{tenant}
# TENANT_DB_URL=mongodb+srv://USER:PASSWORD@HOST/ready-deliveries

# Optional: use if all client CNAME records should point to one fixed host.
# CNAME_TARGET_DOMAIN=custom.readydeliveries.com

# Optional: only set at web build time if API is on a separate hostname.
# VITE_API_URL=https://api.readydeliveries.com

# Optional legacy external tenant service. Leave empty for single-repo mode.
# SUPER_ADMIN_URL=

# Required when ENVIROMENT is not local. Protects Swagger docs at /api.
# API_DOCS_USER=
# API_DOCS_PASSWORD=

# Optional: required only for chatbot/embedding endpoints.
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_DIMENSIONS=1536
