    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^uuid$": "<rootDir>/test-utils/uuid.mock.ts",
      "^src/(.*)$": "<rootDir>/$1"
